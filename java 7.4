import java.util.LinkedList;

// Step-1: Define the PC class containing the shared buffer and synchronization logic
class PC {
    // Shared buffer between producer and consumer
    private final LinkedList<Integer> buffer = new LinkedList<>();
    private final int capacity = 2; // Fixed capacity of the buffer
    private int value = 0;          // Value to be produced

    // Step-2: Implement the produce method
    public void produce() throws InterruptedException {
        while (true) {
            synchronized (this) {
                // If the buffer is full, the producer waits
                while (buffer.size() == capacity) {
                    wait();
                }

                // Add item to the buffer
                buffer.add(value);
                System.out.println("Producer produced-" + value);
                value++;

                // Notify the consumer thread that an item is available
                notify();
            }
            
            // Sleep for 1 second outside the synchronized block to allow interleaving
            Thread.sleep(1000);
        }
    }

    // Step-3: Implement the consume method
    public void consume() throws InterruptedException {
        while (true) {
            synchronized (this) {
                // If the buffer is empty, the consumer waits
                while (buffer.size() == 0) {
                    wait();
                }

                // Remove the first item from the buffer
                int val = buffer.removeFirst();
                System.out.println("Consumer consumed-" + val);

                // Notify the producer thread that space is available
                notify();
            }

            // Sleep for 1 second outside the synchronized block to allow interleaving
            Thread.sleep(1000);
        }
    }
}

// Step-4: Main class to instantiate and run the threads
public class ProducerConsumerDemo {
    public static void main(String[] args) {
        PC pc = new PC();

        // Create the Producer thread
        Thread producerThread = new Thread(() -> {
            try {
                pc.produce();
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        });

        // Create the Consumer thread
        Thread consumerThread = new Thread(() -> {
            try {
                pc.consume();
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        });

        // Start both threads
        producerThread.start();
        consumerThread.start();

        // Join both threads to the main execution
        try {
            producerThread.join();
            consumerThread.join();
        } catch (InterruptedException e) {
            System.out.println("Main thread interrupted.");
        }
    }
}
